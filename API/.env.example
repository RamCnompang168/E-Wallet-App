# Django Core Settings
DJANGO_SECRET_KEY=production-secret-key-change-me-minimum-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

# Database (PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ewallet_db
DATABASE_USER=ewallet_user
DATABASE_PASSWORD=ewallet_secure_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Alternatively, specify DATABASE_URL
DATABASE_URL=postgresql://ewallet_user:ewallet_secure_password@localhost:5432/ewallet_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-me-for-production
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email / Notification Gateway (Mock or SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@example.com
EMAIL_HOST_PASSWORD=smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NovaPay Alerts <no-reply@novapay.bank>

# Payment Provider Gateway Simulation
PAYMENT_PROVIDER_KEY=prov_live_sample_key_938481
PAYMENT_PROVIDER_SECRET=prov_sec_sample_secret_772183
WEBHOOK_SECRET=webhook_hmac_signing_secret_991823
